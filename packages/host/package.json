    "@deepseek-ai/dsh-util-values": "0.2.0-rc.2",
    "zod": "4.4.3",
    "cheerio": "1.2.0",
    "sanitize-html": "2.17.7",
    "fast-xml-parser": "5.11.1",
    "@mozilla/readability": "0.6.0",
    "linkedom": "0.18.13",
    "undici": "8.11.2",
